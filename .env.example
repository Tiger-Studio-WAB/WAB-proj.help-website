# Supabase (from Project Settings → API, or `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: Vercel AI Gateway key for idea/response translation.
# On Vercel production, OIDC can supply this automatically.
AI_GATEWAY_API_KEY=

# Local Supabase Azure (Microsoft) provider — also set in supabase/.env
AZURE_CLIENT_ID=
AZURE_SECRET=
# Optional WAB tenant, e.g. https://login.microsoftonline.com/<tenant-id>
AZURE_TENANT_URL=
